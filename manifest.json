{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.8",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "alarms",
    "identity",
    "notifications"
  ],
  "host_permissions": [
    "*://*.motionelements.com/*",
    "*://*.audiio.com/*",
    "*://*.dova-s.jp/*",
    "*://*.bgmer.net/*",
    "*://*.maou.audio/*",
    "*://*.bgmusic.jp/*",
    "*://*.ryu110.com/*",
    "*://*.fukidesign.com/*",
    "*://*.artlist.io/*",
    "*://*.epidemicsound.com/*",
    "*://elements.envato.com/*",
    "*://*.envato.com/*",
    "*://*.mixkit.co/*",
    "*://*.stock.adobe.com/*",
    "*://*.motionarray.com/*",
    "*://*.amazonaws.com/*",
    "*://*.cloudfront.net/*",
    "*://*.telnyxcloudstorage.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.motionelements.com/*"],
      "js": ["content/motionelements.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.audiio.com/*"],
      "js": ["content/audiio.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.dova-s.jp/*"],
      "js": ["content/dova.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.bgmer.net/*"],
      "js": ["content/bgmer.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.maou.audio/*"],
      "js": ["content/maoudamashii.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.bgmusic.jp/*"],
      "js": ["content/bgmusic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.ryu110.com/*"],
      "js": ["content/ryuitomusic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.fukidesign.com/*"],
      "js": ["content/fukidesign.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.artlist.io/*"],
      "js": ["content/artlist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.epidemicsound.com/*"],
      "js": ["content/epidemicsound.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://elements.envato.com/*", "*://*.envato.com/*"],
      "js": ["content/envato.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.mixkit.co/*"],
      "js": ["content/mixkit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.stock.adobe.com/*"],
      "js": ["content/adobestock.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.motionarray.com/*"],
      "js": ["content/motionarray.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["lib/extpay.vendor.js"],
      "run_at": "document_start"
    }
  ],
  "oauth2": {
    "client_id": "480657238230-8vskcel8e9bvoid66613unreeu4vidqv.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_appTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html"
}
